# OS / editor junk
.DS_Store
Thumbs.db
__MACOSX/
*.swp

# Old zip backups (do not re-add zipped copies of tracked folders)
*.zip

# CodeIgniter runtime output
application/logs/*
!application/logs/index.html
application/cache/*
!application/cache/index.html

# User-uploaded runtime files (may contain personal data - never commit)
uploads/*
!uploads/*/
!uploads/**/.gitkeep

# Local environment / secrets
.env
application/config/database.local.php

# Environment-specific web-server config (forced HTTPS redirect, PHP
# handler/version, and - once added per docs/AdminTool_Hostinger_Deployment_Guide.docx -
# SetEnv DB_*/CI_ENV credentials). Differs per instance (local Laragon vs
# Hostinger DEV vs Hostinger PROD); each environment maintains its own copy
# on disk rather than sharing one tracked file.
.htaccess

# Composer dependencies (installed via `composer install`)
vendor/

# PHPUnit result cache
.phpunit.cache/

# Session files written by the test harness's throwaway PHP server
# (tests/run-tests.sh, tests/serve-test-app.sh)
tests/.session-tmp/

# Playwright (e2e/) - npm dependencies and run artifacts
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.cache/
